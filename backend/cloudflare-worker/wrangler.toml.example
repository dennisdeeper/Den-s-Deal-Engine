name = "deal-engine-api"
main = "worker.js"
compatibility_date = "2026-09-01"

# Existing secrets should remain configured in Cloudflare:
# EBAY_CLIENT_ID
# EBAY_CLIENT_SECRET
#
# Optional:
# UPCITEMDB_USER_KEY
# UPCITEMDB_KEY_TYPE
# EBAY_MARKETPLACE_ID = "EBAY_GB"
# MDE_MIN_IMMEDIATE_ROI = "50"
# MDE_DEFAULT_FEE_RATE = "0.13"
#
# Production Live Market storage:
#
# [[kv_namespaces]]
# binding = "MDE_MARKET_KV"
# id = "YOUR_KV_NAMESPACE_ID"
#
# Admin write authentication:
# Preferred secret: MDE_ADMIN_TOKEN
# Backward-compatible existing secret: ADMIN_TOKEN
#
# Verify after deployment:
# /health -> marketStorage="kv", marketAdminConfigured=true
# /live-market/status -> storage="kv", adminWriteReady=true
